<?xml version="1.0" encoding="utf-8"?>
<!-- "full" flavor only (GitHub APK). The Play flavor omits this service: Google Play restricts the Accessibility API to accessibility use. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Optional: hardware Volume Up + Down combo while the screen is off. User enables it in Accessibility settings. -->
        <service
            android:name=".service.VolumeComboService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_combo_service" />
        </service>
    </application>
</manifest>
